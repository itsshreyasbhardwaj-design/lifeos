{
  "manifest_version": 3,
  "name": "LifeOS Capture",
  "version": "0.1.0",
  "description": "Save the current page, selected text or a quick task to your LifeOS Inbox. Reads a page only when you click.",
  "action": { "default_popup": "popup.html", "default_title": "Save to LifeOS", "default_icon": { "128": "icon-128.png" } },
  "icons": { "128": "icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "minimum_chrome_version": "116"
}
