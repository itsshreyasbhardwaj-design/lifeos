# LifeOS configuration. Copy to .env at the repository root.

# --- Required in production ------------------------------------------------
# 32+ random characters. Encrypts files at rest and signs internal tokens.
# Losing it makes stored files unreadable. Generate: openssl rand -base64 48
LIFEOS_SECRET=

# Public origin, used for sitemap, Open Graph and invitation links.
LIFEOS_PUBLIC_URL=http://localhost:3200

# --- Database ---------------------------------------------------------------
# Empty → embedded PostgreSQL (PGlite) in data/pglite.
# A path → PGlite at that path. postgres://… → a PostgreSQL server.
DATABASE_URL=
DATABASE_POOL_SIZE=10

# --- Background work ----------------------------------------------------------
# The web server runs the worker in-process unless set to 0.
LIFEOS_INPROCESS_WORKER=1
LIFEOS_WORKER_INTERVAL_MS=3000
# Enables POST /api/v1/cron/tick for platforms without a long-lived worker.
LIFEOS_CRON_SECRET=

# --- Files & OCR ----------------------------------------------------------------
LIFEOS_FILES_DIR=
LIFEOS_OCR_DIR=
LIFEOS_MAX_UPLOAD_BYTES=20971520
# Set 0 to store captured links without fetching them.
LIFEOS_FETCH_URLS=1

# --- Web Push (generated into data/vapid.json in development if unset) ----------
LIFEOS_VAPID_PUBLIC=
LIFEOS_VAPID_PRIVATE_PEM=
LIFEOS_VAPID_SUBJECT=mailto:admin@example.com
LIFEOS_PUSH=1

# --- Billing ----------------------------------------------------------------------
# Deep-merged over the default plans, e.g. {"plus":{"limits":{"extractions":800}}}
LIFEOS_PLANS_JSON=
RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
# Never enable in production: allows switching plans without payment.
LIFEOS_ENABLE_DEV_BILLING=0

# --- Networking -----------------------------------------------------------------------
# Trust X-Forwarded-For (only behind your own reverse proxy).
LIFEOS_TRUST_PROXY=0
# Development over plain http with NODE_ENV=production only.
LIFEOS_INSECURE_COOKIES=0
